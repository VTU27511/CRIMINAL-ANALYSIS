rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User profile avatars: Anyone authenticated can view; user can upload own photo (< 5MB, image only)
    match /profile_photos/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == userId
      ) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // FIR Attachments, documents, crime scene evidence:
    // Only authenticated investigators can upload and read
    match /fir_documents/{firId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
